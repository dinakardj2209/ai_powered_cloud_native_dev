{
  "name": "devflow",
  "version": "1.0.0",
  "private": true,
  "description": "DevFlow — AI-Powered Cloud-Native Developer Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @devflow/api",
    "dev:web": "npm run dev -w @devflow/web",
    "build": "npm run build -w @devflow/shared && npm run build -w @devflow/api && npm run build -w @devflow/web",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed -w @devflow/api",
    "lint": "npm run build -w @devflow/shared && npm run lint --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
